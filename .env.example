# Supabase — obrigatório para geração e persistência
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OpenRouter — obrigatório para agentes; o roteador só aceita IDs gratuitos
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# API Roblox → Forge3D: segredo apenas no servidor Roblox e Vercel
FORGE_HMAC_KEY_ID=primary
FORGE_HMAC_KEY_ID_PREVIOUS=
FORGE_HMAC_SECRET=
FORGE_HMAC_SECRET_PREVIOUS=
# Token compartilhado com Scripts de servidor Roblox (mínimo 32 caracteres; nunca usar em LocalScript)
FORGE_ROBLOX_TOKEN=
MAX_PLAYER_JOBS_PER_HOUR=3
# Proteção do Cron Vercel
CRON_SECRET=
# Configuração
APP_ENV=production
LOG_LEVEL=info
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Forge3D Cloud
MAX_JOB_STAGES_PER_TICK=1
MAX_TRIANGLES=20000