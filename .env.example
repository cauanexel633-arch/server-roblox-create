# ============ OBRIGATÓRIAS ============
# Supabase (service_role somente server-side; NUNCA expor ao Roblox)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticação HMAC dos servidores Roblox (segredo existe só no servidor do jogo e na Vercel)
FORGE_HMAC_KEY_ID=
FORGE_HMAC_SECRET=

# Autorização do Vercel Cron (>= 32 caracteres; a Vercel envia como "Authorization: Bearer <valor>")
CRON_SECRET=

# ============ OPCIONAIS (integração fica "aguardando credencial" se vazias) ============
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
WEB_SEARCH_API_KEY=
ROBLOX_UNIVERSE_ID=
ROBLOX_OPEN_CLOUD_API_KEY=
# Segredo anterior, aceito durante a rotação do FORGE_HMAC_SECRET
FORGE_HMAC_SECRET_PREVIOUS=
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=
APP_ENV=development
LOG_LEVEL=info
