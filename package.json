{
  "name": "forge3d-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Forge3D Cloud — motor de geração de armas e assets 3D para Roblox (backend serverless).",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
