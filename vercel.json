{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/[...path].ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/:path*" }
  ],
  "crons": [
    { "path": "/internal/process-queue", "schedule": "0 12 * * *" }
  ]
}
