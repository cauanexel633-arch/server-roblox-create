{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index?__forge_original_path=/:path*"
    }
  ],
  "crons": [
    { "path": "/internal/process-queue", "schedule": "*/5 * * * *" }
  ]
}
